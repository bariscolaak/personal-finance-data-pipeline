# Example only. Copy to .env and provide your own registered application details.
# Keep the environment and all bank endpoints consistent.
ERSTE_ENVIRONMENT=sandbox
ERSTE_BASE_URL=https://webapi.developers.erstegroup.com/api/csas/public/sandbox/v3/accounts
ERSTE_API_KEY=replace_with_your_sandbox_api_key
# web_app.py obtains the access token through OAuth and keeps it in memory.
ERSTE_ACCESS_TOKEN=
ERSTE_CLIENT_ID=replace_with_your_oauth_client_id
ERSTE_CLIENT_SECRET=replace_with_your_oauth_client_secret
ERSTE_REDIRECT_URI=http://127.0.0.1:5000/oauth/callback
ERSTE_AUTH_URL=https://webapi.developers.erstegroup.com/api/csas/sandbox/v1/sandbox-idp/auth
ERSTE_TOKEN_URL=https://webapi.developers.erstegroup.com/api/csas/sandbox/v1/sandbox-idp/token
ERSTE_SCOPE=
ERSTE_API_KEY_HEADER=web-api-key
ERSTE_ACCOUNTS_PATH=my/accounts

# Databricks SQL Warehouse connection details.
DATABRICKS_SERVER_HOSTNAME=dbc-example.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/replace_with_warehouse_id
DATABRICKS_CATALOG=replace_with_your_catalog
DATABRICKS_SCHEMA=portfolio
